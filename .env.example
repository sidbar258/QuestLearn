# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is gitignored; this template is not. Never put a real key here.
# ---------------------------------------------------------------------------

# Claude API key — enables AI-written questions and quest lines.
# Without it QuestLearn still runs end to end on the offline question bank,
# so the app is fully playable before you set this.
#
# Get a real one at https://console.anthropic.com/settings/keys
# The value below is a fake of the right shape, so you can see what you're
# pasting. It will fail authentication on purpose.
ANTHROPIC_API_KEY=sk-ant-api03-THIS-IS-NOT-A-REAL-KEY-REPLACE-ME-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxAA

# Optional: how long to wait for generated content before falling back to the
# cache and then the offline bank (ms). The brief budgets 3–5s for AI content.
# QUESTLEARN_AI_TIMEOUT_MS=9000

# Optional: where the SQLite file lives.
# QUESTLEARN_DATA_DIR=./data

# Optional: signs parent session cookies. Auto-generated and stored in the DB
# if unset — set it explicitly if you run more than one instance.
# QUESTLEARN_SECRET=

# Test-only: enables /api/dev/peek, which reveals the answer to the question a
# student is currently looking at, so scripts/e2e.ts can play deliberately well
# or badly. It is a 404 unless this is exactly "1". Never set it in production.
# QUESTLEARN_E2E=1
